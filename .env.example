# Medar frontend build configuration (public values only).
# Keep empty for a same-origin API; set only when the API is hosted on another origin.
VITE_API_BASE_URL=

# true: show operational sign-in UI (requires a working API).
# false: hide sign-in UI for the public static showcase.
VITE_ENABLE_AUTH_UI=true

# true: build a standalone UI/demo that never calls the API.
# This is not a real offline database or operational mode.
# The GitHub Pages workflow sets this to true automatically.
VITE_DISABLE_API_UI=false

# Never place DATABASE_URL, Cloudflare tokens, session secrets, or other server secrets
# in this file or any VITE_* variable. Set server secrets in the hosting provider's
# protected environment configuration instead.
