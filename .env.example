# Medar web app uses same-origin Cloudflare Worker API; no email, OTP, or Neon Auth URL is required.
# Set only when the API is deployed on a separate origin:
VITE_API_BASE_URL=
VITE_ENABLE_AUTH_UI=true

# Temporary legacy operational data modules still read Supabase until their APIs are migrated.
# Do not put service-role keys or database credentials in VITE_ variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
