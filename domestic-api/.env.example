# Copy to the hosting panel's environment settings; never commit real credentials.
NODE_ENV=production
HOST=127.0.0.1
PORT=8788
APP_ORIGIN=https://YOUR-DOMAIN.example
MYSQL_URL=mysql://DB_USER:URL_ENCODED_PASSWORD@127.0.0.1:3306/DB_NAME
# Set true only when the hosting reverse proxy strips and sets these headers itself.
TRUST_PROXY_HEADERS=false
