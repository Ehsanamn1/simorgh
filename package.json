{
  "name": "simorgh-network-operations",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "mobile:build": "node scripts/build-mobile.mjs",
    "mobile:android:prepare": "node scripts/build-mobile.mjs android",
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "build:pages": "npm run typecheck && vite build --base=/simorgh/",
    "test:e2e": "playwright test",
    "serve:pages:test": "node scripts/serve-pages-simulation.mjs",
    "mobile:ios:prepare": "node scripts/build-mobile.mjs ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.0.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/geolocation": "^8.2.3",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.4",
    "recharts": "^2.15.4",
    "@neondatabase/serverless": "^1.0.2",
    "hono": "^4.9.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@eslint/js": "^9.38.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.38.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.9",
    "vitest": "^5.0.4",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5"
  }
